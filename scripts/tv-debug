#!/usr/bin/env python3
"""Switch the UxPlay overlay without restarting playback."""
import argparse
import os
from pathlib import Path
import socket
import stat
import sys
import uuid


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=('on', 'off', 'status'))
    args = parser.parse_args()
    directory = Path.home() / '.uxplay-control'
    client = directory / ('client-' + uuid.uuid4().hex[:12])
    bound = False
    try:
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise RuntimeError('Unsafe control directory permissions.')
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as connection:
            connection.settimeout(3)
            connection.bind(str(client))
            bound = True
            connection.connect(str(directory / 'control.sock'))
            connection.send(args.mode.encode('ascii'))
            response = connection.recv(256).decode('utf-8')
        print(response)
        return 1 if response.startswith('ERROR') else 0
    except (FileNotFoundError, ConnectionRefusedError):
        print('Receiver is not running or does not support tv-debug.', file=sys.stderr)
        return 1
    except socket.timeout:
        print('Receiver did not reply. Run tv-debug status to check whether the change applied.', file=sys.stderr)
        return 1
    except (OSError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        return 1
    finally:
        try:
            if bound:
                client.unlink()
        except FileNotFoundError:
            pass


if __name__ == '__main__':
    sys.exit(main())
