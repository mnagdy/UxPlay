#!/usr/bin/env python3
"""Build a pinned, unprivileged Weston prototype; never install system packages.

Run on the Pi from a source snapshot. The first run resolves missing build
dependencies using the existing authenticated APT metadata, records their exact
versions and SHA256 values, and extracts them into the dedicated trial directory.
Later runs reuse that lock. No compositor, receiver or seat daemon is started.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shlex
import subprocess
import tarfile
from urllib.parse import unquote, urlparse

SOURCE_URL = "https://deb.debian.org/debian/pool/main/w/weston/weston_14.0.2.orig.tar.xz"
SOURCE_SHA256 = "b47216b3530da76d02a3a1acbf1846a9cd41d24caa86448f9c46f78f20b6e0ac"
SEATD_URL = "https://deb.debian.org/debian/pool/main/s/seatd/seatd_0.9.1.orig.tar.gz"
SEATD_SHA256 = "819979c922a0be258aed133d93920bce6a3d3565a60588d6d372ce9db2712cd3"
PREFIX_NAME = "weston-14.0.2-piplay"
PACKAGES = ["meson", "ninja-build", "libcairo2-dev", "libpixman-1-dev",
            "libinput-dev", "libseat-dev", "libdisplay-info-dev",
            "libxkbcommon-dev", "libevdev-dev", "wayland-protocols", "seatd"]
OPTIONS = ["--buildtype=release", "--libdir=lib", "--wrap-mode=nodownload",
           "-Dbackend-drm=true", "-Dbackend-headless=true", "-Dbackend-default=drm",
           "-Dbackend-drm-screencast-vaapi=false", "-Dbackend-pipewire=false",
           "-Dbackend-rdp=false", "-Dbackend-vnc=false", "-Dbackend-wayland=false",
           "-Dbackend-x11=false", "-Dscreenshare=false", "-Dremoting=false",
           "-Dpipewire=false", "-Dxwayland=false", "-Dsystemd=false",
           "-Dshell-desktop=false", "-Dshell-fullscreen=false", "-Dshell-ivi=false",
           "-Dshell-kiosk=true", "-Dcolor-management-lcms=false",
           "-Dimage-jpeg=false", "-Dimage-webp=false", "-Ddemo-clients=false",
           "-Dtools=debug,info", "-Dsimple-clients=shm", "-Dwcap-decode=false",
           "-Dtests=false", "-Ddoc=false"]


def run(args, **kwargs):
    return subprocess.run([str(x) for x in args], check=True, **kwargs)


def output(args):
    return run(args, capture_output=True, text=True).stdout


def sha256(path):
    with path.open("rb") as handle:
        return hashlib.file_digest(handle, "sha256").hexdigest()


def download(url, destination, digest):
    if destination.exists() and sha256(destination) == digest:
        return
    partial = destination.with_suffix(destination.suffix + ".partial")
    run(["curl", "--fail", "--location", "--silent", "--show-error",
         "--proto", "=https", "--proto-redir", "=https", "--output", partial, url])
    if sha256(partial) != digest:
        partial.unlink()
        raise RuntimeError(f"SHA256 mismatch: {destination.name}")
    partial.replace(destination)


def dependency_lock(root):
    lock_path = root / "dependency-lock.json"
    if lock_path.exists():
        return json.loads(lock_path.read_text())
    plan = output(["apt-get", "-o", "Debug::NoLocking=1", "--print-uris",
                   "--yes", "--no-install-recommends", "install", *PACKAGES])
    packages = []
    for line in plan.splitlines():
        if not line.startswith("'"):
            continue
        url, filename, *_ = shlex.split(line)
        name, version, arch_deb = unquote(filename).split("_")
        metadata = output(["apt-cache", "show", f"{name}={version}"])
        digest = re.search(r"^SHA256: ([0-9a-f]{64})$", metadata, re.M)
        if not digest:
            raise RuntimeError(f"APT has no SHA256 for {name}={version}")
        parsed = urlparse(url)
        if parsed.scheme not in ("http", "https") or not parsed.netloc:
            raise RuntimeError("APT returned an unsupported download URL")
        packages.append({"package": name, "version": version,
                         "file": unquote(filename),
                         "url": parsed._replace(scheme="https").geturl(),
                         "sha256": digest.group(1)})
    lock = {"architecture": platform.machine(), "packages": packages,
            "installed_baseline": output(["dpkg-query", "-W",
                                            "-f=${binary:Package}\t${Version}\n"])}
    lock_path.write_text(json.dumps(lock, indent=2) + "\n")
    return lock


def extract_dependencies(root, lock):
    deps = root / "deps"
    archives = root / "archives"
    deps.mkdir(exist_ok=True)
    archives.mkdir(exist_ok=True)
    for package in lock["packages"]:
        archive = archives / package["file"]
        download(package["url"], archive, package["sha256"])
        run(["dpkg-deb", "--extract", archive, deps])
    # Relocate only the extracted pkg-config metadata. System dependencies keep
    # their ordinary /usr paths; a global PKG_CONFIG_SYSROOT_DIR would break them.
    relocated = set()
    for candidate in deps.rglob("*.pc"):
        pc = candidate.resolve()
        if pc in relocated or not pc.is_relative_to(deps):
            continue
        pc.write_text(pc.read_text().replace("/usr", str(deps / "usr")))
        relocated.add(pc)
    # A dev package may point to its runtime library already installed on the Pi.
    # Supply only absent symlink targets from that installed baseline.
    for link in list(deps.rglob("*")):
        if not link.is_symlink() or link.exists():
            continue
        raw = os.readlink(link)
        target = (link.parent / raw).resolve()
        if not target.is_relative_to(deps):
            continue
        system = Path("/") / target.relative_to(deps)
        if system.is_file():
            target.parent.mkdir(parents=True, exist_ok=True)
            target.symlink_to(system)
    return deps


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path,
                        default=Path.home() / "uxplay-dev/display-trial")
    parser.add_argument("--jobs", type=int, default=2)
    args = parser.parse_args()
    if os.geteuid() == 0:
        parser.error("Run as the receiver user; this helper never needs root.")
    if platform.system() != "Linux" or platform.machine() != "aarch64":
        parser.error("This recipe targets the aarch64 Raspberry Pi test environment.")
    if not 1 <= args.jobs <= 4:
        parser.error("Use 1 to 4 build jobs.")
    root = args.root.expanduser().resolve()
    if not root.is_relative_to(Path.home().resolve()) or root == Path.home().resolve():
        parser.error("The dedicated build root must be inside your home directory.")
    root.mkdir(parents=True, exist_ok=True)
    patch_root = Path(__file__).resolve().parent.parent / "patches"
    patches = [patch_root / "weston-p030.patch", patch_root / "weston-kiosk-no-seat.patch"]
    patch_digest = hashlib.sha256("".join(sha256(p) for p in patches).encode()).hexdigest()
    deps = extract_dependencies(root, dependency_lock(root))
    prefix = root / PREFIX_NAME
    env = os.environ.copy()
    env["PATH"] = f"{deps}/usr/bin:" + env.get("PATH", "")
    env["PYTHONPATH"] = f"{deps}/usr/lib/python3/dist-packages"
    env["PKG_CONFIG_PATH"] = ":".join([str(deps / "usr/lib/aarch64-linux-gnu/pkgconfig"),
                                       str(deps / "usr/share/pkgconfig"),
                                       env.get("PKG_CONFIG_PATH", "")])
    env["LD_LIBRARY_PATH"] = f"{prefix}/lib:{deps}/usr/lib/aarch64-linux-gnu"
    archive = root / "archives/weston-14.0.2.tar.xz"
    download(SOURCE_URL, archive, SOURCE_SHA256)
    source = root / "source/weston-14.0.2"
    stamp = root / "source-patch.sha256"
    if source.exists() and (not stamp.exists() or stamp.read_text().strip() != patch_digest):
        raise RuntimeError("Existing source uses another patch. Use a new dedicated --root.")
    if not source.exists():
        source.parent.mkdir(exist_ok=True)
        with tarfile.open(archive) as tar:
            tar.extractall(source.parent, filter="data")
        for patch in patches:
            run(["patch", "--batch", "--fuzz=0", "-p1", "-i", patch], cwd=source)
        stamp.write_text(patch_digest + "\n")
    build = root / "build"
    setup = ["meson", "setup", build, source, f"--prefix={prefix}", *OPTIONS]
    if (build / "build.ninja").exists():
        setup.insert(2, "--reconfigure")
        setup.insert(2, "--clearcache")
    run(setup, env=env)
    run(["meson", "compile", "-C", build, "-j", args.jobs], env=env)
    run(["meson", "install", "-C", build, "--no-rebuild"], env=env)
    seatd_archive = root / "archives/seatd-0.9.1.tar.gz"
    download(SEATD_URL, seatd_archive, SEATD_SHA256)
    seatd_source = root / "source/seatd-0.9.1"
    if not seatd_source.exists():
        with tarfile.open(seatd_archive) as tar:
            tar.extractall(source.parent, filter="data")
    seatd_build = root / "seatd-build"
    seatd_prefix = root / "seatd-private"
    seatd_setup = ["meson", "setup", seatd_build, seatd_source,
                   f"--prefix={seatd_prefix}", "--libdir=lib", "--wrap-mode=nodownload",
                   "-Ddefaultpath=seatd.sock", "-Dlibseat-logind=disabled",
                   "-Dman-pages=disabled", "-Dexamples=disabled"]
    if (seatd_build / "build.ninja").exists():
        seatd_setup.insert(2, "--reconfigure")
    run(seatd_setup, env=env)
    run(["meson", "compile", "-C", seatd_build, "-j", args.jobs], env=env)
    run(["meson", "install", "-C", seatd_build, "--no-rebuild"], env=env)
    version = output_with_env([prefix / "bin/weston", "--version"], env)
    manifest = {"source_url": SOURCE_URL, "source_sha256": SOURCE_SHA256,
                "patch_sha256": patch_digest, "configure": setup,
                "patches": {p.name: sha256(p) for p in patches},
                "weston": str(prefix / "bin/weston"),
                "seatd": str(seatd_prefix / "bin/seatd"),
                "seatd_source_url": SEATD_URL, "seatd_source_sha256": SEATD_SHA256,
                "seatd_defaultpath": "seatd.sock",
                "library_path": env["LD_LIBRARY_PATH"], "version": version.strip(),
                "qualification": "Build only; headless, HDMI, HEVC and handover tests required."}
    manifest["binary_sha256"] = {
        str(path): sha256(path) for path in
        [prefix / "bin/weston", prefix / "lib/weston/kiosk-shell.so",
         seatd_prefix / "bin/seatd"]}
    manifest["modules"] = {
        "drm_backend": str(prefix / "lib/libweston-14/drm-backend.so"),
        "headless_backend": str(prefix / "lib/libweston-14/headless-backend.so"),
        "gl_renderer": str(prefix / "lib/libweston-14/gl-renderer.so"),
        "kiosk_shell": str(prefix / "lib/weston/kiosk-shell.so")}
    manifest["backend_cli"] = "Use --backend=drm or headless; Weston 14 rejects an absolute backend path."
    manifest["configure"] = [str(x) for x in setup]
    (root / "build-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    print(json.dumps(manifest, indent=2))


def output_with_env(args, env):
    return run(args, env=env, capture_output=True, text=True).stdout


if __name__ == "__main__":
    main()
